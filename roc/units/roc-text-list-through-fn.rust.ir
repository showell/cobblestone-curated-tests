  (defs
  (def "through" "RocTextListThroughFn" (params (param "n" int-default)) (fn int-default text) (let "x" (list text) (list-expr (elems (text-lit "a") (text-lit "b")) text) (let "result" (list text) (name "x" (list text)) (apply (apply (name "list-at" (fn (list text) (fn int-default text))) (name "result" (list text)) (fn int-default text)) (int-lit 0) text))) 0 0)
  (def "opening" "RocTextListThroughFn" (params) (effectful (effs "Console") (scopes "") nothing) (act (stmts (do-exec (apply (name "print-line-uni" (fn text nothing (row (labels (label "Console.Write" "")) "" 463))) (apply (name "through" (fn int-default text)) (int-lit 0) text) nothing))) nothing) 0 0)))

  (defs
  (def "even" "RocMutualEvenOdd" (params (param "n" int-default)) (fn int-default boolean) (if (binary eq (name "n" int-default) (int-lit 0) boolean) (bool-lit true) (apply (name "odd" (fn int-default boolean)) (binary sub-int (name "n" int-default) (int-lit 1) int-default) boolean) boolean) 0 0)

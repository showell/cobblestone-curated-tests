  (def "opening" "RocMutualEvenOdd" (params) (effectful (effs "Console") (scopes "") nothing) (act (stmts (do-exec (apply (name "print-line-uni" (fn text nothing (row (labels (label "Console.Write" "")) "" 463))) (if (apply (name "even" (fn int-default boolean)) (int-lit 10) boolean) (text-lit "true") (text-lit "false") text) nothing)) (do-exec (apply (name "print-line-uni" (fn text nothing (row (labels (label "Console.Write" "")) "" 469))) (if (apply (name "odd" (fn int-default boolean)) (int-lit 11) boolean) (text-lit "true") (text-lit "false") text) nothing)) (do-exec (apply (name "print-line-uni" (fn text nothing (row (labels (label "Console.Write" "")) "" 475))) (apply (name "show" (fn int-default text)) (apply (name "depth" (fn int-default int-default)) (int-lit 512) int-default) text) nothing))) nothing) 0 0)))

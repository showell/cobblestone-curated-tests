(chapter "Program"
  (title "RocRecursiveVar")
  (prose "")
  (pblocks)
  (anns)
  (sections "Construction" "Slicing" "Slicing(extended)" "Map and Fold" "Filter and Search" "Definitions" "Definitions" "Functions" "Entry")
  (ctors "MkTup2" "MkTup3" "MkTup4" "MkTup5")
  (eff-ops "print-line-uni" "read-line")
  (grounds)
  (type-defs
  (var-def "Tup2" (tparams "a" "b") (ctors (var-ctor "MkTup2" (fields (a-named "a") (a-named "b")))))
  (var-def "Tup3" (tparams "a" "b" "c") (ctors (var-ctor "MkTup3" (fields (a-named "a") (a-named "b") (a-named "c")))))
  (var-def "Tup4" (tparams "a" "b" "c" "d") (ctors (var-ctor "MkTup4" (fields (a-named "a") (a-named "b") (a-named "c") (a-named "d")))))
  (var-def "Tup5" (tparams "a" "b" "c" "d" "e") (ctors (var-ctor "MkTup5" (fields (a-named "a") (a-named "b") (a-named "c") (a-named "d") (a-named "e"))))))
  (defs
  (def "f" "RocRecursiveVar" (params (param "n" int-default)) (fn int-default int-default) (let "state" int-default (name "n" int-default) (if (binary gt (name "n" int-default) (int-lit 0) boolean) (let "inner" int-default (apply (name "f" (fn int-default int-default)) (binary sub-int (name "n" int-default) (int-lit 1) int-default) int-default) (binary add-int (name "state" int-default) (name "inner" int-default) int-default)) (name "state" int-default) int-default)) 0 0)
  (def "opening" "RocRecursiveVar" (params) (effectful (effs "Console") (scopes "") nothing) (act (stmts (do-exec (apply (name "print-line-uni" (fn text nothing (row (labels (label "Console.Write" "")) "" 457))) (apply (name "show" (fn int-default text)) (apply (name "f" (fn int-default int-default)) (int-lit 3) int-default) text) nothing))) nothing) 0 0)))

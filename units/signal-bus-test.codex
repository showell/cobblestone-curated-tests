Chapter: SignalBus
  cites Foreword chapter Maybe

 We say:

Section: Signal Types

  Signal =
    | SigTerm
    | SigKill
    | SigHup
    | SigUsr1
    | SigUsr2
    | SigChild (Integer)
    | SigAlarm (Integer)

  SignalEntry = record {
    target-pid : Integer,
    signal : Signal,
    from-pid : Integer,
    timestamp : Integer
  }

  SignalQueue = record {
    pending : List SignalEntry,
    count : Integer between 0 and 65535,
    delivered : Integer between 0 and 4294967295
  }

Section: Queue Operations

  signal-queue-empty : SignalQueue
  signal-queue-empty = SignalQueue { pending = [], count = 0, delivered = 0 }

  signal-send : SignalQueue, Integer, Integer, Signal, Integer -> SignalQueue
  signal-send (q) (from) (to) (sig) (ts) =
    let entry = SignalEntry { target-pid = to, signal = sig, from-pid = from, timestamp = ts }
    in SignalQueue { pending = list-push (q.pending) entry, count = q.count + 1, delivered = q.delivered }

  signal-peek : SignalQueue, Integer -> Maybe SignalEntry
  signal-peek (q) (pid) = find-signal (q.pending) pid 0 (q.count)

  find-signal : List SignalEntry, Integer, Integer, Integer -> Maybe SignalEntry
  find-signal (entries) (pid) (i) (len) =
    if i >= len then None
    else let e = list-at entries i
    in if e.target-pid == pid then Just e
    else find-signal entries pid (i + 1) len

  signal-consume : SignalQueue, Integer -> SignalQueue
  signal-consume (q) (pid) =
    let filtered = remove-first-for (q.pending) pid 0 (q.count) [] False
    in SignalQueue { pending = filtered, count = __narrow (list-length filtered), delivered = q.delivered + 1 }

  remove-first-for : List SignalEntry, Integer, Integer, Integer, List SignalEntry, Boolean -> List SignalEntry
  remove-first-for (entries) (pid) (i) (len) (acc) (removed) =
    if i >= len then acc
    else let e = list-at entries i
    in if removed then remove-first-for entries pid (i + 1) len (list-push acc e) True
    else if e.target-pid == pid then remove-first-for entries pid (i + 1) len acc True
    else remove-first-for entries pid (i + 1) len (list-push acc e) False

Section: Broadcast

  signal-broadcast : SignalQueue, List Integer, Signal, Integer, Integer -> SignalQueue
  signal-broadcast (q) (pids) (sig) (from) (ts) =
    broadcast-loop q pids sig from ts 0 (list-length pids)

  broadcast-loop : SignalQueue, List Integer, Signal, Integer, Integer, Integer, Integer -> SignalQueue
  broadcast-loop (q) (pids) (sig) (from) (ts) (i) (len) =
    if i >= len then q
    else broadcast-loop (signal-send q from (list-at pids i) sig ts) pids sig from ts (i + 1) len

Section: Queries

  signal-pending-count : SignalQueue -> Integer
  signal-pending-count (q) = q.count

  signal-delivered-count : SignalQueue -> Integer
  signal-delivered-count (q) = q.delivered

  signal-pending-for : SignalQueue, Integer -> Integer
  signal-pending-for (q) (pid) = count-for-pid (q.pending) pid 0 (q.count) 0

  count-for-pid : List SignalEntry, Integer, Integer, Integer, Integer -> Integer
  count-for-pid (entries) (pid) (i) (len) (acc) =
    if i >= len then acc
    else let e = list-at entries i
    in count-for-pid entries pid (i + 1) len (acc + (if e.target-pid == pid then 1 else 0))

Section: Formatting

  format-signal : Signal -> Text
  format-signal (s) = when s
    is SigTerm -> "SIGTERM"
    is SigKill -> "SIGKILL"
    is SigHup -> "SIGHUP"
    is SigUsr1 -> "SIGUSR1"
    is SigUsr2 -> "SIGUSR2"
    is SigChild (pid) -> "SIGCHILD(" & show pid & ")"
    is SigAlarm (ticks) -> "SIGALARM(" & show ticks & ")"

  format-signal-entry : SignalEntry -> Text
  format-signal-entry (e) = show (e.from-pid) & "->" & show (e.target-pid) & " " & format-signal (e.signal)

  signal-queue-stats : SignalQueue -> Text
  signal-queue-stats (q) = "pending=" & show (q.count) & " delivered=" & show (q.delivered)

Page 1

Chapter: SignalBusTest
  cites Sched chapter SignalBus
  cites Foreword chapter Maybe

Section: Helpers
  show-peek : Maybe SignalEntry -> Text
  show-peek (m) = when m
    is Just (e) -> format-signal (e.signal)
    is None -> "none"

Section: Tests
  test-empty : Text =
    let q = signal-queue-empty
    in signal-queue-stats q

  test-send-peek-consume : Text =
    let q0 = signal-queue-empty
    in let q1 = signal-send q0 1 5 SigTerm 100
    in let q2 = signal-send q1 2 7 SigHup 200
    in let peek5 = signal-peek q2 5
    in let peek9 = signal-peek q2 9
    in let q3 = signal-consume q2 5
    in "pending=" & show (signal-pending-count q2) & " peek5=" & show-peek peek5 & " peek9=" & show-peek peek9 & " after-consume=" & show (signal-pending-count q3) & " delivered=" & show (signal-delivered-count q3)

  test-broadcast : Text =
    let q0 = signal-queue-empty
    in let q1 = signal-broadcast q0 [2, 5, 7, 3] SigKill 1 300
    in "pending=" & show (signal-pending-count q1) & " for-2=" & show (signal-pending-for q1 2) & " for-9=" & show (signal-pending-for q1 9)

  test-format-entry : Text =
    let e = SignalEntry { target-pid = 1, signal = SigChild 5, from-pid = 5, timestamp = 400 }
    in format-signal-entry e

  test-multi-pending : Text =
    let q0 = signal-queue-empty
    in let q1 = signal-send q0 1 7 SigUsr1 100
    in let q2 = signal-send q1 2 7 SigUsr2 200
    in let q3 = signal-send q2 3 7 (SigAlarm 60) 300
    in "for-7=" & show (signal-pending-for q3 7)

  test-consume-order : Text =
    let q0 = signal-queue-empty
    in let q1 = signal-send q0 1 3 SigUsr1 100
    in let q2 = signal-send q1 2 3 SigUsr2 200
    in let q3 = signal-consume q2 3
    in let next = signal-peek q3 3
    in "remaining=" & show (signal-pending-count q3) & " next=" & show-peek next

  opening : [Console] Nothing = act
    print-line-uni test-empty
    print-line-uni test-send-peek-consume
    print-line-uni test-broadcast
    print-line-uni test-format-entry
    print-line-uni test-multi-pending
    print-line-uni test-consume-order
  end

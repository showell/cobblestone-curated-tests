Chapter: Console

 We say:

Section: Definitions

  effect Console where
    print-line-uni : Text -> [Console.Write] Nothing
    read-line  : [Console.Read] Text

Page 1

Chapter: TextFoldIndexed
  cites Foreword chapter TextScan
  cites Foreword chapter Console

Section: Body
  count-vowels : Text -> Integer
  count-vowels (s) = text-fold-indexed s 0 (\acc ch idx ->
    if ch == 'a' then acc + 1
    else if ch == 'e' then acc + 1
    else if ch == 'i' then acc + 1
    else if ch == 'o' then acc + 1
    else if ch == 'u' then acc + 1
    else acc)

  opening : [Console] Nothing = act
    let r1 = text-fold-indexed "abc" 0 (\acc ch idx -> acc + idx)
    in let r2 = text-fold-indexed "hello" "" (\acc ch idx -> acc & integer-to-text idx)
    in let r3 = count-vowels "hello world"
    in let r4 = text-fold-indexed "test" 0 (\acc ch idx -> acc + 1)
    in act
      print-line-uni (show r1)
      print-line-uni r2
      print-line-uni (show r3)
      print-line-uni (show r4)
    end
  end


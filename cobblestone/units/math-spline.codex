Chapter: Quaternion

 We say:

Section: Types
  Quat = record {
    w : Real,
    x : Real,
    y : Real,
    z : Real
  }

  Vec3 = record {
    vx : Real,
    vy : Real,
    vz : Real
  }

Section: Construction
  quat-identity : Quat
  quat-identity = Quat { w = 1.0, x = 0.0, y = 0.0, z = 0.0 }

  quat-new : Real, Real, Real, Real -> Quat
  quat-new (w) (x) (y) (z) = Quat { w = w, x = x, y = y, z = z }

  vec3-new : Real, Real, Real -> Vec3
  vec3-new (x) (y) (z) = Vec3 { vx = x, vy = y, vz = z }

  vec3-zero : Vec3
  vec3-zero = Vec3 { vx = 0.0, vy = 0.0, vz = 0.0 }

Section: Quaternion Arithmetic
  quat-multiply : Quat, Quat -> Quat
  quat-multiply (a) (b) = Quat {
    w = a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z,
    x = a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
    y = a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
    z = a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w
  }

  quat-conjugate : Quat -> Quat
  quat-conjugate (q) = Quat { w = q.w, x = -q.x, y = -q.y, z = -q.z }

  quat-add : Quat, Quat -> Quat
  quat-add (a) (b) = Quat { w = a.w + b.w, x = a.x + b.x, y = a.y + b.y, z = a.z + b.z }

  quat-scale-by : Quat, Real -> Quat
  quat-scale-by (q) (s) = Quat { w = q.w * s, x = q.x * s, y = q.y * s, z = q.z * s }

  quat-norm-squared : Quat -> Real
  quat-norm-squared (q) = q.w * q.w + q.x * q.x + q.y * q.y + q.z * q.z

  quat-dot : Quat, Quat -> Real
  quat-dot (a) (b) = a.w * b.w + a.x * b.x + a.y * b.y + a.z * b.z

Section: Rotation
  quat-from-axis-angle : Vec3, Real -> Quat
  quat-from-axis-angle (axis) (angle) =
    let half = angle / 2.0
    in let sin-h = quat-sin-approx half
    in let cos-h = quat-cos-approx half
    in Quat { w = cos-h, x = axis.vx * sin-h, y = axis.vy * sin-h, z = axis.vz * sin-h }

  quat-rotate-vec : Quat, Vec3 -> Vec3
  quat-rotate-vec (q) (v) =
    let p = Quat { w = 0.0, x = v.vx, y = v.vy, z = v.vz }
    in let qp = quat-multiply q p
    in let result = quat-multiply qp (quat-conjugate q)
    in Vec3 { vx = result.x, vy = result.y, vz = result.z }

Section: Trig Approximation
  quat-sin-approx : Real -> Real
  quat-sin-approx (rad) =
    let x = rad
    in let x3 = x * x * x
    in x - x3 / 6.0

  quat-cos-approx : Real -> Real
  quat-cos-approx (rad) =
    let x2 = rad * rad
    in let x4 = x2 * x2
    in 1.0 - x2 / 2.0 + x4 / 24.0

Section: Square Root
  quat-real-sqrt : Real -> Real
  quat-real-sqrt (n) = if n <= 0.0 then 0.0 else quat-real-sqrt-loop n (n / 2.0 + 1.0)

  quat-real-sqrt-loop : Real, Real -> Real
  quat-real-sqrt-loop (n) (guess) =
    let next = (guess + n / guess) / 2.0
    in if next ~ guess then next else quat-real-sqrt-loop n next

Section: Interpolation
  quat-normalize : Quat -> Quat
  quat-normalize (q) =
    let len-sq = q.w * q.w + q.x * q.x + q.y * q.y + q.z * q.z
    in let len = quat-real-sqrt len-sq
    in if len ~ 0.0 then quat-identity
    else Quat { w = q.w / len, x = q.x / len, y = q.y / len, z = q.z / len }

  quat-slerp : Quat, Quat, Real -> Quat
  quat-slerp (a) (b) (t) =
    let dot = quat-dot a b
    in let b2 = if dot < 0.0 then Quat { w = 0.0 - b.w, x = 0.0 - b.x, y = 0.0 - b.y, z = 0.0 - b.z } else b
    in let dot2 = if dot < 0.0 then 0.0 - dot else dot
    in if dot2 > 0.95 then quat-nlerp a b2 t
    else let inv-t = 1.0 - t
    in let result = quat-add (quat-scale-by a inv-t) (quat-scale-by b2 t)
    in quat-normalize result

  quat-nlerp : Quat, Quat, Real -> Quat
  quat-nlerp (a) (b) (t) =
    let inv-t = 1.0 - t
    in quat-normalize (quat-add (quat-scale-by a inv-t) (quat-scale-by b t))

Section: Common Rotations
  quat-rotate-x : Real -> Quat
  quat-rotate-x (angle) = quat-from-axis-angle (vec3-new 1.0 0.0 0.0) angle

  quat-rotate-y : Real -> Quat
  quat-rotate-y (angle) = quat-from-axis-angle (vec3-new 0.0 1.0 0.0) angle

  quat-rotate-z : Real -> Quat
  quat-rotate-z (angle) = quat-from-axis-angle (vec3-new 0.0 0.0 1.0) angle

Section: Vector Operations
  vec3-add : Vec3, Vec3 -> Vec3
  vec3-add (a) (b) = Vec3 { vx = a.vx + b.vx, vy = a.vy + b.vy, vz = a.vz + b.vz }

  vec3-subtract : Vec3, Vec3 -> Vec3
  vec3-subtract (a) (b) = Vec3 { vx = a.vx - b.vx, vy = a.vy - b.vy, vz = a.vz - b.vz }

  vec3-scale : Vec3, Real -> Vec3
  vec3-scale (v) (s) = Vec3 { vx = v.vx * s, vy = v.vy * s, vz = v.vz * s }

  vec3-dot : Vec3, Vec3 -> Real
  vec3-dot (a) (b) = a.vx * b.vx + a.vy * b.vy + a.vz * b.vz

  vec3-cross : Vec3, Vec3 -> Vec3
  vec3-cross (a) (b) = Vec3 {
    vx = a.vy * b.vz - a.vz * b.vy,
    vy = a.vz * b.vx - a.vx * b.vz,
    vz = a.vx * b.vy - a.vy * b.vx
  }

  vec3-length-squared : Vec3 -> Real
  vec3-length-squared (v) = v.vx * v.vx + v.vy * v.vy + v.vz * v.vz

Section: Formatting
  format-quat : Quat -> Text
  format-quat (q) = "(" & show (q.w) & "," & show (q.x) & "," & show (q.y) & "," & show (q.z) & ")"

  format-vec3 : Vec3 -> Text
  format-vec3 (v) = "(" & show (v.vx) & "," & show (v.vy) & "," & show (v.vz) & ")"


Chapter: Tuple

Section: Definitions

  Tup2 (a) (b) =
    | MkTup2 (a) (b)

  Tup3 (a) (b) (c) =
    | MkTup3 (a) (b) (c)

  Tup4 (a) (b) (c) (d) =
    | MkTup4 (a) (b) (c) (d)

  Tup5 (a) (b) (c) (d) (e) =
    | MkTup5 (a) (b) (c) (d) (e)

  pair-first : (a, b) -> a
  pair-first (p) =
   let (x, y) = p in x

  pair-second : (a, b) -> b
  pair-second (p) =
   let (x, y) = p in y

Page 1

Chapter: Maybe

 We say:

Section: Definitions

  Maybe (a) =
    | Just (a)
    | None

  from-maybe : Maybe a, a -> a
  from-maybe (m) (default) = when m
    is Just (x) -> x
    is None -> default

  is-just : Maybe a -> Boolean
  is-just (m) = when m
    is Just (x) -> True
    is None -> False

  is-none : Maybe a -> Boolean
  is-none (m) = when m
    is Just (x) -> False
    is None -> True

  maybe-map : (a -> b), Maybe a -> Maybe b
  maybe-map (f) (m) = when m
    is Just (x) -> Just (f x)
    is None -> None

  maybe-bind : Maybe a, (a -> Maybe b) -> Maybe b
  maybe-bind (m) (f) = when m
    is Just (x) -> f x
    is None -> None


  (def "opening" "StringEscapeQuote" (params) (effectful (effs "Console") (scopes "") nothing) (act (stmts (do-exec (apply (name "print-line-uni" (fn text nothing (row (labels (label "Console.Write" "")) "" 454))) (name "q" text) nothing))) nothing) 0 0)))
